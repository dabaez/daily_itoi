# Copy to /etc/todays-darling.env, chmod 600, owned by the deploy user.

# Required: Claude API key for the translation step.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: translation engine (claude | passthrough) and model override.
# TRANSLATOR=claude
# CLAUDE_MODEL=claude-sonnet-5

# Optional: where to write today.json (defaults to ../web/today.json from builder/).
# TODAY_JSON=/srv/todays-darling/web/today.json
