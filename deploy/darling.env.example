# Secrets for the daily job (deploy/systemd/darling-build.service).
# On the droplet: /srv/sites/darling/darling.env, owned darling:darling, chmod 600.
# systemd reads it: plain KEY=value lines, no `export`, no quotes needed.

# Required: Claude API key for the translation step.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: translation engine (claude | passthrough) and model override.
# TRANSLATOR=claude
# CLAUDE_MODEL=claude-sonnet-5
