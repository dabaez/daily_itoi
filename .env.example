# Local settings for the builder. Copy to .env (gitignored) and fill in:
#   cp .env.example .env
# Then run from builder/ with:  uv run --env-file ../.env build.py
# (The server has its own file: deploy/darling.env.example.)

# Claude API key for the translation step. Not needed with TRANSLATOR=passthrough.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: translation engine (claude | passthrough) and model override.
# TRANSLATOR=claude
# CLAUDE_MODEL=claude-sonnet-5
